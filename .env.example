# Browser-safe Supabase configuration.
# The publishable key is designed for browser use. Never put the service-role
# key here or in supabase-config.json.
#
# IMPORTANT: this project is previewed with a static file server. Do not keep
# a real .env file inside the web root. Copy this example outside the project
# directory and run:
#   ENV_FILE=../clites.env node scripts/generate-supabase-config.mjs
# A static server can serve .env and other dotfiles if they live in the root.

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_YOUR_PUBLISHABLE_KEY

# Optional aliases if this static site is later moved to Vite. The current
# site does not use Vite, so these are read only as a fallback by the config
# generator.
# VITE_SUPABASE_URL=
# VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never expose this to the frontend or commit it. If you add
# server-side functions later, keep these values outside the web root and in a
# proper server secret manager.
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_SECRET_KEY=
